# Supabase (optional for local play: without it MoodReel runs in guest mode)
NEXT_PUBLIC_SUPABASE_URL=
# New projects are issued a publishable key (sb_publishable_...). Older projects
# use the legacy anon JWT as NEXT_PUBLIC_SUPABASE_ANON_KEY; either name works.
# Both are browser-safe and protected by row level security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, and genuinely secret (sb_secret_... or the legacy service role
# JWT). Never expose to the browser. Not required by the MVP.
SUPABASE_SERVICE_ROLE_KEY=

# TMDb API Read Access Token (v4 bearer). Server-only.
TMDB_ACCESS_TOKEN=

# Public base URL, used for auth redirects and PWA metadata.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: region used for watch-provider lookups.
TMDB_WATCH_REGION=IN
