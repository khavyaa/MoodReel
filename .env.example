# Postgres. Locally: `docker compose up -d` gives you this URL.
# On Vercel: the Neon integration sets DATABASE_URL for you.
DATABASE_URL=postgres://moodreel:moodreel@localhost:5433/moodreel
# Separate database for `npm run test:db` and `npm run test:e2e` (tests wipe it).
DATABASE_URL_TEST=postgres://moodreel:moodreel@localhost:5433/moodreel_test

# Signs sessions and setup grants. Generate: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Unlocks /setup: creating the account, or adding a passkey on a new device.
# Generate: openssl rand -base64 24. Keep it somewhere safe; it's your recovery key.
OWNER_SETUP_TOKEN=

# TMDb API Read Access Token (v4). Server-only. Used from Phase 2.
TMDB_ACCESS_TOKEN=
TMDB_WATCH_REGION=IN

# Optional. The address you open the app at; passkeys are bound to it.
# Locally it defaults to http://localhost:3000; on Vercel, to the production domain.
APP_URL=

# Books: New York Times bestseller lists (optional, free key from developer.nytimes.com with
# the Books API enabled). Without it, books use Open Library alone.
NYT_API_KEY=
# Vercel sends this to /api/cron/nyt when the daily sync runs. Any long random string.
CRON_SECRET=
